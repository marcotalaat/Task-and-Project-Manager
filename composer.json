{
    "name": "marco/task-project-manager",
    "description": "A WordPress task and project management plugin built with Acorn.",
    "type": "wordpress-plugin",
    "require": {
        "roots/acorn": "^6.3"
    },
    "autoload": {
        "psr-4": {
            "Marco\\TaskProjectManager\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
        ]
    }
}